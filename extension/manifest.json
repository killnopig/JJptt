{
  "manifest_version": 3,
  "name": "JJptt",
  "version": "1.28.1",
  "description": "在瀏覽器裡上 PTT，透過本機程式直接連線 ptt.cc。",
  "key": "",
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_title": "開啟 JJptt",
    "default_icon": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "identity",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.ptt.cc/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
