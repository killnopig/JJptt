<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of JJptt's goes into Google's cloud backup or a
     phone-to-phone transfer (the saved PTT login is in the app's data).
     Settings move with 設定 → 匯出設定檔 instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
